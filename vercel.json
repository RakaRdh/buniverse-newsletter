{
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.9.0"
    },
    "api/debug.php": {
      "runtime": "vercel-php@0.9.0"
    },
    "api/test_config.php": {
      "runtime": "vercel-php@0.9.0"
    },
    "api/test_config3.php": {
      "runtime": "vercel-php@0.9.0"
    }
  },
  "routes": [
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "src": "/api/debug.php",
      "dest": "/api/debug.php"
    },
    {
      "src": "/api/test_config.php",
      "dest": "/api/test_config.php"
    },
    {
      "src": "/api/test_config3.php",
      "dest": "/api/test_config3.php"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ]
}
